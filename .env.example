# ---- Server-side only (Vercel Functions). NEVER prefix with VITE_, never expose to client ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_APP_SHORT_NAME=app
APP_BASE_URL=https://tginteractive.vercel.app
# MAX — server-only (separate from Telegram; token never VITE_)
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=se14154487_bot
# Recommended on Vercel when platform-api2.max.ru requires the Russian Trusted CA chain.
# Prefer PEM over NODE_EXTRA_CA_CERTS paths created at runtime.
MAX_EXTRA_CA_PEM=
# Alternative only if this file is guaranteed to exist before the Function starts:
MAX_EXTRA_CA_PATH=

# ---- Client-side (public). VITE_ prefix is required for client bundle inclusion ----
VITE_ANALYTICS_PROVIDER=console
VITE_TELEGRAM_BOT_USERNAME=takeiteasybefore
VITE_TELEGRAM_APP_SHORT_NAME=app
VITE_MAX_BOT_USERNAME=se14154487_bot
